{
  "files.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/.venv": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true
  },

  "[go]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "go.lintTool": "staticcheck",

  "[javascript][javascriptreact][typescript][typescriptreact][json][css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.workingDirectories": ["gateway-ui"],
  "tailwindCSS.experimental.configFile": "gateway-ui/src/index.css",

  "[python]": {
    "editor.formatOnSave": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/ml-service/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["ml-service"],
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/ml-service",
  "python.testing.pytestArgs": ["tests"]
}
