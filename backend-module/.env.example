# Copy to .env (git-ignored) and set real values.

# Table owner / admin login
POSTGRES_DB=fallguard
POSTGRES_USER=fallguard_admin
POSTGRES_PASSWORD=change-me

# Login used by ml-service (restricted, row-level security applies)
# ml-service: ML_DATABASE_URL=postgresql://ml_service:<this password>@db:5432/fallguard
ML_SERVICE_PASSWORD=change-me-too

# prod (true) or dev (false). Dev fills a new database with demo data (3 sample cameras, 4
# sample falls); prod starts empty: only the facility (demo-facility) and its fall rule, and
# you add the real cameras in the app. Unset = prod. Only read when the database is new.
PROD_MODE=false

# Optional: true / false loads / skips the demo data whatever the mode.
# SEED_DEMO_DATA=

# Host port binding. 127.0.0.1 = this machine only; 0.0.0.0 = whole network.
DB_BIND=127.0.0.1
DB_PORT=5432

# How many months of partitions to keep created ahead (including the current one).
PARTITION_MONTHS_AHEAD=3
