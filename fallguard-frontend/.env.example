# Frontend settings. Copy to .env to change them: cp .env.example .env
# Every line is optional: with none set, the app uses the same-origin defaults below,
# which is what Docker (nginx) and `npm run dev` (Vite proxy) expect.

# Core backend REST API. Default: /api
# VITE_API_BASE_URL=/api

# stream-hub: live video WebSocket, fall clips, snapshots. Default: /stream-hub
# VITE_STREAM_BASE_URL=/stream-hub

# `npm run dev` only: where the dev server forwards /api and /stream-hub.
# Defaults: http://localhost:8000 (API) and http://localhost:9000 (stream-hub).
# VITE_API_PROXY=http://localhost:8100
# VITE_STREAM_PROXY=http://localhost:9000
