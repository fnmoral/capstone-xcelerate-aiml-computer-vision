# ==============================================================================================
#  FALLGUARD SETTINGS
# ==============================================================================================
#
#  HOW TO USE THIS FILE
#
#   1. Make a copy of this file named  .env  in the same folder.
#        Windows:  Copy-Item .env.example .env
#        Mac:      cp .env.example .env
#   2. Open .env and change the two passwords in "REQUIRED" below.
#   3. Start everything:  docker compose up -d --build
#
#  - This is the only settings file you need. Every part of FallGuard reads it.
#  - Keep .env private: never upload it, share it or paste it anywhere.
#  - Lines starting with # are ignored. To change an OPTIONAL setting, remove the # in front.
#  - What each setting means is explained at the bottom of this file.
#
# ==============================================================================================


# ----------------------------------------------------------------------------------------------
#  REQUIRED: set these before the first start
# ----------------------------------------------------------------------------------------------

POSTGRES_PASSWORD=change-me
ML_SERVICE_PASSWORD=change-me-too

PROD_MODE=false
COMPOSE_PROFILES=test-camera


# ----------------------------------------------------------------------------------------------
#  OPTIONAL: leave as they are unless you need to change them (shown with their defaults)
# ----------------------------------------------------------------------------------------------

# Database
# POSTGRES_DB=fallguard
# POSTGRES_USER=fallguard_admin
# DB_BIND=127.0.0.1
# DB_PORT=5433
# PARTITION_MONTHS_AHEAD=3
# SEED_DEMO_DATA=
# ML_DATABASE_URL=

# Web addresses (ports) on this computer
# FRONTEND_PORT=3000
# API_PORT=8100
# GATEWAY_PORT=8080
# STREAM_HUB_HTTP_PORT=9000
# STREAM_HUB_TCP_PORT=8090

# Gateway
# GATEWAY_STREAM_HUB_ADDRESS=stream-hub:8090
# GATEWAY_BACKEND_ADDRESS=api:8000
# GATEWAY_TENANT_NAME=demo-facility
# GATEWAY_TENANT_ID=demo-facility
# GATEWAY_NAME_ID=default_gateway
# GATEWAY_ID=default_id

# Video recordings
# STREAM_HUB_RETENTION_DAYS=30
# STREAM_HUB_MAX_TOTAL_GB=10

# Web app development (only when running the web app without Docker)
# VITE_API_PROXY=http://localhost:8100
# VITE_STREAM_PROXY=http://localhost:9000

# Fanshawe course server (only when running the AI on the school server; ask the team)
# SERVER_HOST=10.9.103.240
# SERVER_PORT=2201
# SERVER_USER=info6156-g01
# SERVER_PASSWORD=change-me


# ==============================================================================================
#  WHAT EACH SETTING MEANS
# ==============================================================================================
#
#  REQUIRED
#
#  POSTGRES_PASSWORD     Password for the database's main (admin) account. Pick your own.
#  ML_SERVICE_PASSWORD   Password the AI uses to save falls to the database. Pick your own.
#                        Both: letters and digits only (no symbols or spaces). Set them before
#                        the first start; changing them later means resetting the database.
#
#  PROD_MODE             false = practice / demo mode: a new database is filled with a sample week
#                        (3 cameras, recent falls) and this computer's webcam can be used as a camera.
#                        true  = real use: the database starts empty.
#  COMPOSE_PROFILES      test-camera = also start the "test camera" that turns a webcam or a video
#                        into a camera stream. Use it with PROD_MODE=false; delete the line for real use.
#                        (Both only matter when the database is first created. To switch an existing
#                        system: docker compose --profile test-camera down -v, which wipes all data.)
#
#  OPTIONAL: Database
#
#  POSTGRES_DB           Name of the database.
#  POSTGRES_USER         Name of the database's main (admin) account.
#  DB_BIND               Who can reach the database: 127.0.0.1 = only this computer,
#                        0.0.0.0 = every computer on the network.
#  DB_PORT               Port to reach the database from this computer (5433 avoids clashing
#                        with another database already installed).
#  PARTITION_MONTHS_AHEAD  How many months ahead the database prepares storage for.
#  SEED_DEMO_DATA        true / false: add / skip the sample data, whatever the mode.
#  ML_DATABASE_URL       Where the AI saves its results. Leave empty: it's built automatically from
#                        ML_SERVICE_PASSWORD. Set it only to use a database on another machine
#                        (format: postgresql://ml_service:<password>@<host>:5432/fallguard).
#
#  OPTIONAL: Web addresses (ports) on this computer
#
#  FRONTEND_PORT         The FallGuard web app: http://localhost:3000
#  API_PORT              The backend, for troubleshooting only.
#  GATEWAY_PORT          The gateway's own page (add cameras, one-time setup): http://localhost:8080
#  STREAM_HUB_HTTP_PORT  Live video and recordings.
#  STREAM_HUB_TCP_PORT   Where the gateway sends camera video.
#
#  OPTIONAL: Gateway (the program that reads the cameras)
#
#  Used the first time the gateway starts. It must then be set up once on its page
#  (http://localhost:8080, "Configure Now") before cameras can be added.
#  GATEWAY_STREAM_HUB_ADDRESS  Where it sends camera video.
#  GATEWAY_BACKEND_ADDRESS     Where the main system is.
#  GATEWAY_TENANT_NAME / _ID   Which facility it belongs to.
#  GATEWAY_NAME_ID / GATEWAY_ID  This gateway's name and ID.
#
#  OPTIONAL: Video recordings
#
#  STREAM_HUB_RETENTION_DAYS  Recordings older than this many days are deleted.
#  STREAM_HUB_MAX_TOTAL_GB    If recordings use more space than this, the oldest are deleted.
#
#  OPTIONAL: Web app development (developers only)
#
#  VITE_API_PROXY / VITE_STREAM_PROXY  Where "npm run dev" sends its requests. Not used by Docker.
#
#  OPTIONAL: Fanshawe course server (only for running the AI on the school's GPU server)
#
#  SERVER_HOST / SERVER_PORT   The server's address and port.
#  SERVER_USER / SERVER_PASSWORD  The team's login. Ask the team; never share it outside.
#
# ==============================================================================================
