# Copy to .env next to docker-compose.yml (git-ignored). Every module reads it.
#
# Dev / prototyping: sample data in a new database (a week of falls, 3 sample cameras),
# the webcam relay (test camera) starts with the stack, and the API adds this PC's webcam
# as a camera. Run ml-service/tools/publish_webcam.py on the PC for its video.
PROD_MODE=false
COMPOSE_PROFILES=test-camera

# Prod: no sample data (clean slate), no test camera. Use these two lines instead:
#   PROD_MODE=true
#   (no COMPOSE_PROFILES line)
# Without this file the stack runs as prod.
#
# PROD_MODE only changes the sample data when the database is created; to switch an
# existing system, wipe it: docker compose --profile test-camera down -v
